# Denova Compose deployment settings.
# Copy this file to .env and adjust the values; .env must not be committed.

# Login username for remote (non-localhost) access.
DENOVA_USERNAME=admin

# Login password for remote access. Required.
# It is hashed at runtime and takes precedence over passwords set in the UI.
DENOVA_PASSWORD=change-me

# Timezone for the container.
TZ=Asia/Shanghai
